{
  "name": "@closing-bell/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build -w @closing-bell/fairness && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run build -w @closing-bell/fairness && tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "demo:dry-ring": "tsx scripts/demo-dry-ring.ts"
  },
  "dependencies": {
    "@closing-bell/fairness": "*",
    "@resvg/resvg-js": "^2.6.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "sharp": "^0.35.4",
    "viem": "^2.23.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
