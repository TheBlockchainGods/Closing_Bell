# Closing Bell backend. Copy to .env and restart to apply.

FIXTURE_MODE=true
DRY_RUN_PAYOUTS=true
PORT=8787
DATABASE_URL=postgres://bell:bell@localhost:5432/closing_bell
# Remote hosts (Lightsail/RDS) always use TLS with rejectUnauthorized: false.
# sslmode in the URL is ignored. Localhost and docker service names skip TLS.

CHAIN_ID=4663
RPC_URL=
# Alias: CHAIN_RPC_URL
TOKEN_ADDRESS=
CURVE_OR_POOL=
JACKPOT_WALLET=0x1111111111111111111111111111111111111111
# Alias: JACKPOT_WALLET_ADDRESS
GME_TOKEN_ADDRESS=
# PONS v2 + Uniswap v4 (Robinhood Chain). Override only if the protocol moves.
PONS_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
PONS_HOOK_ADDRESS=0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044
UNISWAP_V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
# Only needed when DRY_RUN_PAYOUTS=false. Must match JACKPOT_WALLET. Never commit.
JACKPOT_PRIVATE_KEY=
# Alias: JACKPOT_WALLET_PRIVATE_KEY
# Optional explorer prefix (default: https://robinhoodchain.blockscout.com/tx)
EXPLORER_TX_URL_PREFIX=
# Optional: PAYOUT_GAS_LIMIT=
# Optional: GME_TOKEN_DECIMALS=

# GME/USD stub (used when PRICE_FEED_URL is empty)
GME_USD_PRICE=23.18
PRICE_FEED_URL=

# Ticket + pot knobs
ODDS_CAP_BPS=1000
JACKPOT_SHARE_BPS=2000
MIN_BUY_USD=5
TICKETS_PER_USD=1000
MIN_POT_GME=1
BELLS_24_7=true
SNAPSHOT_LEAD_SECONDS=120
# How late the keeper may still ring a bell it has not settled. Lets a short
# restart catch up; stops an outage from retro-ringing a stale bag.
SETTLE_GRACE_SECONDS=900

# Fixture / until creator fees are wired. Launch starts empty: pot builds from
# fees swept into JACKPOT_WALLET. Do not stub a fake GME balance for go-live.
PONS_CLAIMABLE_GME=0
JACKPOT_WALLET_BALANCE_GME=0

# Indexer + keeper
# Indexer start; at launch set to deploy block or earlier so backfill
# catches first-block / launchAndBuy buys even if the process starts late.
START_BLOCK=0
INDEXER_POLL_MS=2000
KEEPER_POLL_MS=1000

# Telegram (optional. Without token, announces log as [tg:dry])
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public URLs used in Telegram buttons and /verify links
PUBLIC_SITE_URL=https://closingbellonrh.com
PUBLIC_API_URL=https://closing-bell-api.qdwgj1kmyrm0a.us-west-2.cs.amazonlightsail.com
X_URL=https://x.com/ClosingBellOnRH

# NEVER put marketing/ops/dev fee wallets in API responses or client logs.
# Site (Amplify) knobs live in the repo-root .env.example: NEXT_PUBLIC_TOKEN_ADDRESS,
# NEXT_PUBLIC_CHART_URL, NEXT_PUBLIC_API_BASE, NEXT_PUBLIC_DRY_RUN_PAYOUTS.
