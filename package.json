{
  "name": "closing-bell",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "workspaces": [
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build -w @closing-bell/fairness && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "npm run build -w @closing-bell/fairness && tsc --noEmit",
    "test:fairness": "npm run test -w @closing-bell/fairness"
  },
  "dependencies": {
    "@closing-bell/fairness": "*",
    "framer-motion": "^13.3.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
